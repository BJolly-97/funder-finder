<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Palette ===== -->
    <Color x:Key="CreamColor">#EDE0D4</Color>
    <Color x:Key="SandColor">#E6CCB2</Color>
    <Color x:Key="TanColor">#DDB892</Color>
    <Color x:Key="ClayColor">#9C6644</Color>
    <Color x:Key="BarkColor">#7F5539</Color>
    <!-- Beyond the base palette: text dark enough to read on tan, and a warning red. -->
    <Color x:Key="InkColor">#3D2817</Color>
    <Color x:Key="BrickColor">#7A3020</Color>

    <!-- ===== Roles — restyle by changing these ===== -->

    <!-- Window base. Also the acrylic blur tint (MainWindow reads it from here). -->
    <Color x:Key="WindowBackgroundColor">#DDB892</Color>

    <!-- Bounding frame: title banner, window border, primary buttons -->
    <SolidColorBrush x:Key="FrameBrush" Color="{StaticResource BarkColor}"/>
    <SolidColorBrush x:Key="FrameTextBrush" Color="{StaticResource CreamColor}"/>

    <!-- View tabs -->
    <SolidColorBrush x:Key="TabActiveBrush" Color="{StaticResource ClayColor}"/>
    <SolidColorBrush x:Key="TabActiveTextBrush" Color="#FFFAF5"/>
    <SolidColorBrush x:Key="TabHoverBrush" Color="#339C6644"/>

    <!-- Surfaces on the base: status strip, row hover -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SandColor}"/>
    <SolidColorBrush x:Key="RowHoverBrush" Color="#66EDE0D4"/>

    <!-- Text on the base, by emphasis -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource InkColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5A3D27"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#6B4A32"/>

    <!-- Accents: star, checked boxes, "open" group heading -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource BarkColor}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource ClayColor}"/>

    <!-- Text box outlines: soft at rest, clay while typing -->
    <SolidColorBrush x:Key="FieldBorderBrush" Color="#C9A07E"/>
    <SolidColorBrush x:Key="FieldFocusBorderBrush" Color="{StaticResource ClayColor}"/>

    <!-- Shortlisted leaf -->
    <SolidColorBrush x:Key="ShortlistBrush" Color="#4B6043"/>

    <!-- Closing-soon warning -->
    <SolidColorBrush x:Key="UrgentBrush" Color="{StaticResource BrickColor}"/>
    <SolidColorBrush x:Key="UrgentTextBrush" Color="{StaticResource CreamColor}"/>

    <!-- Small-control hovers and scrollbar -->
    <SolidColorBrush x:Key="IconHoverBrush" Color="#4D9C6644"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#407A3020"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#809C6644"/>

</ResourceDictionary>
