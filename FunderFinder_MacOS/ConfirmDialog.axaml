<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FunderFinder.Mac.ConfirmDialog"
        Width="360" SizeToContent="Height" CanResize="False"
        SystemDecorations="None" TransparencyLevelHint="Transparent" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <!-- Same look as the main window: bark banner, light body, rounded corners -->
    <Border Margin="10" CornerRadius="12" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource FrameBrush}" BorderThickness="1.5" BoxShadow="0 2 14 0 #593D2817" ClipToBounds="True">
        <StackPanel>
            <Border Background="{StaticResource FrameBrush}" Padding="14,8" PointerPressed="Banner_PointerPressed">
                <TextBlock x:Name="TitleText" Foreground="{StaticResource FrameTextBrush}" FontSize="13" FontWeight="SemiBold"/>
            </Border>
            <TextBlock x:Name="MessageText" Margin="16,14,16,4" TextWrapping="Wrap" FontSize="13"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,12,16,14" Spacing="8">
                <Button x:Name="CancelButton" Classes="action" Content="Cancel" MinWidth="80" HorizontalContentAlignment="Center"
                        Click="Cancel_Click" IsCancel="True"/>
                <Button x:Name="ConfirmButton" Classes="action primary" MinWidth="80" HorizontalContentAlignment="Center"
                        Click="Confirm_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
