<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The palette, carried over from Master Tasks. Change these to restyle the app.
         The acrylic tint itself is set in MainWindow.Window_Loaded (it takes raw RGB). -->
    <Color x:Key="NavyColor">#264D59</Color>
    <Color x:Key="TealColor">#43978D</Color>
    <Color x:Key="ButterColor">#F9E07F</Color>
    <Color x:Key="ApricotColor">#F9AD6A</Color>
    <Color x:Key="TerracottaColor">#D46C4E</Color>

    <SolidColorBrush x:Key="ButterBrush" Color="{StaticResource ButterColor}"/>
    <SolidColorBrush x:Key="ApricotBrush" Color="{StaticResource ApricotColor}"/>
    <SolidColorBrush x:Key="TerracottaBrush" Color="{StaticResource TerracottaColor}"/>

    <!-- Translucent teal tints, from faint to strong -->
    <SolidColorBrush x:Key="TealFaintBrush" Color="#1A43978D"/>
    <SolidColorBrush x:Key="TealHoverBrush" Color="#2E43978D"/>
    <SolidColorBrush x:Key="TealBorderBrush" Color="#4443978D"/>
    <SolidColorBrush x:Key="TealAccentBrush" Color="#8043978D"/>

    <SolidColorBrush x:Key="TerracottaTintBrush" Color="#33D46C4E"/>
    <SolidColorBrush x:Key="ActivePillBrush" Color="#55F9AD6A"/>

    <!-- Text, by emphasis -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F0FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#90FFFFFF"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#70FFFFFF"/>

</ResourceDictionary>
