<Window x:Class="FunderFinder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
        xmlns:models="clr-namespace:FunderFinder.Models"
        Title="Funder Finder"
        Width="360" Height="540" MinWidth="280" MinHeight="300"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01264D59"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34"
                             ResizeBorderThickness="6"
                             GlassFrameThickness="0"
                             CornerRadius="0"
                             UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Two filtered views over the same saved calls, both grouped by deadline bucket
             (Closing soon, Open, Rolling, Closed) and sorted by date within each. -->
        <CollectionViewSource x:Key="OpportunitiesView" Filter="OpportunitiesView_Filter">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="BucketName"/>
            </CollectionViewSource.GroupDescriptions>
            <CollectionViewSource.SortDescriptions>
                <scm:SortDescription PropertyName="BucketOrder" Direction="Ascending"/>
                <scm:SortDescription PropertyName="DeadlineSortKey" Direction="Ascending"/>
            </CollectionViewSource.SortDescriptions>
        </CollectionViewSource>

        <CollectionViewSource x:Key="ShortlistView" Filter="ShortlistView_Filter">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="BucketName"/>
            </CollectionViewSource.GroupDescriptions>
            <CollectionViewSource.SortDescriptions>
                <scm:SortDescription PropertyName="BucketOrder" Direction="Ascending"/>
                <scm:SortDescription PropertyName="DeadlineSortKey" Direction="Ascending"/>
            </CollectionViewSource.SortDescriptions>
        </CollectionViewSource>

        <DataTemplate x:Key="BucketHeaderTemplate">
            <TextBlock FontSize="11" FontWeight="SemiBold" Margin="4,8,0,4">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Open"/>
                        <Setter Property="Foreground" Value="{StaticResource ButterBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Name}" Value="ClosingSoon">
                                <Setter Property="Text" Value="&#x26A0; Closing within two weeks"/>
                                <Setter Property="Foreground" Value="{StaticResource TerracottaBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Name}" Value="Rolling">
                                <Setter Property="Text" Value="Rolling / no fixed deadline"/>
                                <Setter Property="Foreground" Value="{StaticResource ApricotBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Name}" Value="Closed">
                                <Setter Property="Text" Value="Closed"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>

        <!-- Funding call row: star to shortlist, click the title to open the call's page,
             ✕ to hide it as not relevant. -->
        <DataTemplate DataType="{x:Type models:FundingCall}">
            <Grid Margin="2,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="{Binding StarGlyph}" FontSize="14"
                        Width="24" Height="24" VerticalAlignment="Top"
                        Foreground="{StaticResource ButterBrush}"
                        ToolTip="Shortlist" Click="Star_Click"
                        Style="{StaticResource IconButtonStyle}"/>

                <StackPanel Grid.Column="1" Margin="6,2,4,0">
                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"
                               TextWrapping="Wrap" Cursor="Hand" ToolTip="Open the call's web page"
                               MouseLeftButtonUp="OpenCall_Click"/>
                    <TextBlock Text="{Binding Caption}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Summary}" Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                               Margin="0,2,0,0" TextWrapping="Wrap" MaxHeight="30" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <Border Grid.Column="2" CornerRadius="8" Padding="7,3" Margin="0,2,4,0" VerticalAlignment="Top">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="TextElement.Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BucketName}" Value="ClosingSoon">
                                    <Setter Property="Background" Value="{StaticResource TerracottaTintBrush}"/>
                                    <Setter Property="TextElement.Foreground" Value="#FFF3E0DA"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding DeadlineLabel}" FontSize="10.5"/>
                </Border>

                <Button Grid.Column="3" Content="&#x2715;" FontSize="9"
                        Width="20" Height="20" VerticalAlignment="Top" Margin="0,2,0,0"
                        Foreground="{StaticResource TextMutedBrush}"
                        ToolTip="Not relevant — hide this" Click="Dismiss_Click"
                        Style="{StaticResource DangerIconButtonStyle}"/>
            </Grid>
        </DataTemplate>

        <!-- Source row on the Sources tab -->
        <DataTemplate DataType="{x:Type models:SourceEntry}">
            <Grid Margin="2,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" VerticalAlignment="Top" Margin="2,1,10,0"
                          IsChecked="{Binding IsEnabled, Mode=TwoWay}" Click="SourceToggle_Click"
                          Style="{StaticResource RoundedCheckBoxStyle}"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                               Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Border CornerRadius="12" BorderBrush="{StaticResource TealBorderBrush}" BorderThickness="1"
            Background="Transparent" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar / drag region -->
            <Grid Grid.Row="0" Background="{StaticResource TealFaintBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Funder Finder" Foreground="#99FFFFFF" FontSize="12"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                <Button Grid.Column="1" Content="&#x2013;" FontSize="14"
                        Width="30" Height="24" Margin="0,0,4,0" VerticalAlignment="Center"
                        Foreground="#BBFFFFFF" ToolTip="Hide to tray" Click="Hide_Click"
                        Style="{StaticResource IconButtonStyle}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>

            <!-- View pills + Scan -->
            <Grid Grid.Row="1" Margin="6,6,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="OpportunitiesButton" Content="Opportunities" ToolTip="Open calls from all sources"
                                Style="{StaticResource PillButtonStyle}" Click="ShowOpportunities_Click"/>
                        <Button x:Name="ShortlistButton" Content="Shortlist" ToolTip="Calls you've starred"
                                Style="{StaticResource PillButtonStyle}" Click="ShowShortlist_Click"/>
                        <Button x:Name="SourcesButton" Content="Sources" ToolTip="Choose which sources to scan"
                                Style="{StaticResource PillButtonStyle}" Click="ShowSources_Click"/>
                    </StackPanel>
                </ScrollViewer>
                <Button Grid.Column="1" x:Name="ScanButton" Content="&#x21BB; Scan" Padding="10,5" FontSize="11.5"
                        Background="{StaticResource TealAccentBrush}" Foreground="White"
                        ToolTip="Fetch the latest calls from every switched-on source"
                        Click="Scan_Click" Style="{StaticResource BeveledActionButtonStyle}"/>
            </Grid>

            <!-- Status line -->
            <Border Grid.Row="2" Background="#332B4A57" CornerRadius="6" Padding="8,6" Margin="10,8,10,0">
                <TextBlock x:Name="StatusText" Foreground="{StaticResource ApricotBrush}" FontSize="11" TextWrapping="Wrap"/>
            </Border>

            <!-- Content: one panel per view -->
            <Grid Grid.Row="3" Margin="10,8,10,10">
                <Grid x:Name="OpportunitiesPanel">
                    <TextBlock x:Name="OpportunitiesHint" Style="{StaticResource EmptyHintStyle}"
                               Text="No open calls yet — hit Scan to fetch some."/>
                    <ListBox ItemsSource="{Binding Source={StaticResource OpportunitiesView}}"
                             Style="{StaticResource PanelListBoxStyle}">
                        <ListBox.GroupStyle>
                            <GroupStyle HeaderTemplate="{StaticResource BucketHeaderTemplate}"/>
                        </ListBox.GroupStyle>
                    </ListBox>
                </Grid>

                <Grid x:Name="ShortlistPanel" Visibility="Collapsed">
                    <TextBlock x:Name="ShortlistHint" Style="{StaticResource EmptyHintStyle}"
                               Text="Nothing shortlisted — star a call to keep it here."/>
                    <ListBox ItemsSource="{Binding Source={StaticResource ShortlistView}}"
                             Style="{StaticResource PanelListBoxStyle}">
                        <ListBox.GroupStyle>
                            <GroupStyle HeaderTemplate="{StaticResource BucketHeaderTemplate}"/>
                        </ListBox.GroupStyle>
                    </ListBox>
                </Grid>

                <Grid x:Name="SourcesPanel" Visibility="Collapsed">
                    <ListBox x:Name="SourcesListBox" Style="{StaticResource PanelListBoxStyle}"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
